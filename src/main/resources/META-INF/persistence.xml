<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.2"
    xmlns="https://jakarta.ee/xml/ns/persistence"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
    https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd">

    <persistence-unit name="TransacaoPU" transaction-type="JTA">
        <description>Persistence Unit for Jakarta EE 11 with Payara 7 Community and PostgreSQL</description>
        
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>

        <!-- EclipseLink is the default provider in Payara 7 -->
        <jta-data-source>jdbc/postgres_ds</jta-data-source>
        
        <!-- Entity classes -->
        <class>br.com.darley.transacao.jakarta.transacao.model.Transacao</class>
        
        <properties>
            <property name="eclipselink.target-database"
                      value="org.eclipse.persistence.platform.database.PostgreSQLPlatform"/>

            <property name="jakarta.persistence.schema-generation.database.action"
                      value="create-or-extend-tables"/>

            <property name="eclipselink.logging.level" value="INFO"/>
            <property name="eclipselink.logging.level.sql" value="FINE"/>

            <property name="eclipselink.weaving" value="true"/>
        </properties>
    </persistence-unit>
</persistence>